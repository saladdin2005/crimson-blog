---
import Base from '../../layouts/Base.astro';
import { site, type Lang } from '../../data/site';
import { ui } from '../../i18n/ui';

// توليد المسار لللغتين (عربي/إنجليزي)
export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
---
<Base lang={lang} title={`${t.saved} · ${site.name[lang]}`} description={t.saved}>
  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <h1 class="font-display flex items-center gap-3 text-3xl text-stone-900 dark:text-white">
        <span class="grid h-11 w-11 place-items-center rounded-2xl bg-teal-700 text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        </span>
        {t.saved}
      </h1>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        {t.savedEmptyHint}
      </p>
    </header>

    <!-- حالة فارغة -->
    <div data-saved-empty class="classic-frame rounded-3xl px-6 py-16 text-center">
      <p class="text-4xl" aria-hidden="true">🔖</p>
      <p class="mt-4 font-display text-xl text-stone-700 dark:text-stone-200">{t.savedEmpty}</p>
      <a
        href={`/${lang}/`}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-teal-700 px-6 py-3 text-sm font-bold text-white transition hover:bg-teal-600 active:scale-95"
      >
        {t.savedGoHome}
        <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span>
      </a>
    </div>

    <!-- القائمة -->
    <div data-saved-list class="hidden space-y-3"></div>
  </div>
</Base>

<script>
  import { getSaved, removeSaved, type SavedArticle } from '../../scripts/saved';
  import { formatDate } from '../../i18n/ui';

  const lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
  const empty = document.querySelector<HTMLElement>('[data-saved-empty]');
  const list = document.querySelector<HTMLElement>('[data-saved-list]');

  const labels = {
    ar: { remove: 'إزالة من المحفوظات', none: 'لم تحفظ أي مقال بعد.', min: 'دقائق قراءة' },
    en: { remove: 'Remove from saved', none: 'No saved articles yet.', min: 'min read' },
  }[lang];

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  // تنسيق التاريخ المخزن (يُحفظ كـ ISO) كتاريخ مقروء حسب اللغة
  const fmtDate = (d: string) => {
    try { return formatDate(new Date(`${d}T00:00:00Z`), lang); } catch { return d; }
  };

  const render = () => {
    if (!list || !empty) return;
    const items = getSaved(lang);
    if (items.length === 0) {
      empty.classList.remove('hidden');
      list.classList.add('hidden');
      list.innerHTML = '';
      return;
    }
    empty.classList.add('hidden');
    list.classList.remove('hidden');

    list.innerHTML = items
      .map(
        (a: SavedArticle) => `
      <div class="group flex items-center gap-3 rounded-2xl border border-stone-200/70 bg-white p-3 transition hover:border-teal-300 dark:border-white/10 dark:bg-stone-900">
        <a href="${esc(a.url)}" class="flex min-w-0 flex-1 items-center gap-3">
          <span class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-stone-100 dark:bg-stone-800">
            <img src="${esc(a.image)}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" onerror="this.style.display='none'">
            <span class="absolute inset-0" style="background:${a.accent};opacity:.25"></span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="line-clamp-2 text-base font-bold leading-snug text-stone-800 group-hover:text-teal-700 dark:text-stone-100 dark:group-hover:text-teal-400 sm:text-sm">${esc(a.title)}</span>
            <span class="mt-1 flex items-center gap-2 text-xs text-stone-400 dark:text-stone-500">
              <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold text-white" style="background:${a.accent}">${esc(a.catLabel)}</span>
              <span>${esc(fmtDate(a.date))}</span>
            </span>
          </span>
        </a>
        <button type="button" data-remove="${esc(a.slug)}" aria-label="${labels.remove}" title="${labels.remove}"
          class="grid h-11 w-11 shrink-0 place-items-center rounded-full text-stone-400 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-500/10">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
        </button>
      </div>`,
      )
      .join('');

    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        removeSaved(btn.dataset.remove || '');
      });
    });
  };

  render();
  window.addEventListener('saved-changed', render);
</script>
