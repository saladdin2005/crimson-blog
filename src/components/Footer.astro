---
import { site, categories, type Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const socials = [
  { label: 'X (Twitter)', href: site.social.x, icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { label: 'Instagram', href: site.social.instagram, icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z' },
  { label: 'YouTube', href: site.social.youtube, icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
];
---
<footer class="border-t border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-950">
  <div class="mx-auto grid max-w-[1160px] grid-cols-2 gap-x-6 gap-y-10 px-5 py-12 sm:grid-cols-2 sm:gap-10 sm:px-10 lg:grid-cols-4 lg:px-16">
    <div class="col-span-2 sm:col-span-2">
      <div class="flex items-center gap-3">
        <img
          src="/images/logo-icon.png"
          alt=""
          width="40"
          height="40"
          class="h-10 w-10 rounded-2xl object-cover"
        />
        <span class="font-display flex items-baseline gap-2 text-2xl text-stone-900 dark:text-white">
          {site.name[lang]}
          <span class="text-lg font-medium text-stone-400 dark:text-stone-500">{site.name[lang === 'ar' ? 'en' : 'ar']}</span>
        </span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-7 text-stone-500 dark:text-stone-400">{site.tagline[lang]}</p>
      <div class="mt-5">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-stone-400">{t.followUs}</p>
        <div class="flex gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              class="grid h-11 w-11 place-items-center rounded-full border border-stone-200 text-stone-500 transition hover:border-teal-600 hover:bg-teal-600 hover:text-white dark:border-stone-700 dark:text-stone-400"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div>
      <h4 class="text-sm font-black uppercase tracking-widest text-stone-900 dark:text-white">{t.latest}</h4>
      <ul class="mt-2 space-y-0.5 text-sm text-stone-500 dark:text-stone-400">
        {Object.entries(categories).map(([slug, cat]) => (
          <li>
            <a href={`/${lang}/category/${slug}`} class="flex min-h-11 items-center transition hover:text-teal-700 dark:hover:text-teal-400 lg:min-h-0">
              {cat[lang]}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="text-sm font-black uppercase tracking-widest text-stone-900 dark:text-white">{t.about}</h4>
      <ul class="mt-2 space-y-0.5 text-sm text-stone-500 dark:text-stone-400">
        <li><a href={`/${lang}/about`} class="flex min-h-11 items-center transition hover:text-teal-700 dark:hover:text-teal-400 lg:min-h-0">{t.about}</a></li>
        <li><a href={`/${lang}/saved`} class="flex min-h-11 items-center transition hover:text-teal-700 dark:hover:text-teal-400 lg:min-h-0">{t.saved}</a></li>
        <li><a href={`/${lang}/`} class="flex min-h-11 items-center transition hover:text-teal-700 dark:hover:text-teal-400 lg:min-h-0">{t.home}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-stone-100 pt-5 pb-[calc(1.25rem_+_env(safe-area-inset-bottom,0px))] dark:border-stone-900">
    <p class="mx-auto max-w-[1160px] px-5 text-center text-xs text-stone-400 dark:text-stone-500 sm:px-10 lg:px-16">
      © {year} {site.name[lang]} — {t.footerRights}
    </p>
  </div>
</footer>
