---
import { site, type Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;
const home = `/${lang}/`;
const isHome = pathname === home || pathname === `/${lang}`;
const isArticle = pathname.includes('/articles/');
const onCat = pathname.includes('/category/');
---
<!-- شريط تنقّل سفلي ثابت — يظهر على الهاتف فقط (مثل تطبيقات الجوال) -->
<nav
  data-mobile-nav
  aria-label={lang === 'ar' ? 'التنقّل السريع' : 'Quick navigation'}
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-stone-200/70 bg-white/85 backdrop-blur-xl backdrop-saturate-150 supports-[backdrop-filter]:bg-white/75 dark:border-white/10 dark:bg-stone-950/85 dark:supports-[backdrop-filter]:bg-stone-950/75 lg:hidden"
  style="padding-bottom:env(safe-area-inset-bottom)"
>
  <div class="mx-auto flex max-w-md items-stretch">
    <!-- الرئيسية -->
    <a
      href={home}
      class="flex flex-1 flex-col items-center justify-center gap-1 px-1 py-2.5 text-[10px] font-bold transition active:scale-95"
      aria-current={isHome ? 'page' : undefined}
      style={isHome ? 'color:var(--color-teal-600)' : undefined}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isHome ? '2.4' : '2'} stroke-linecap="round" stroke-linejoin="round" opacity={isHome ? '1' : '0.65'}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class={isHome ? '' : 'text-stone-500 dark:text-stone-400'}>{t.home}</span>
    </a>

    <!-- الأقسام (يفتح الدرج) -->
    <button
      type="button"
      data-sidebar-toggle
      aria-label={t.menuLabel}
      aria-expanded="false"
      class="flex flex-1 flex-col items-center justify-center gap-1 px-1 py-2.5 text-[10px] font-bold text-stone-500 transition active:scale-95 dark:text-stone-400"
    >
      <svg class="h-5 w-5 opacity-65" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>{lang === 'ar' ? 'الأقسام' : 'Sections'}</span>
    </button>

    <!-- بحث (يفتح الواجهة الكاملة) -->
    <button
      type="button"
      data-search-open
      aria-label={t.searchPlaceholder}
      class="flex flex-1 flex-col items-center justify-center gap-1 px-1 py-2.5 text-[10px] font-bold text-stone-500 transition active:scale-95 dark:text-stone-400"
    >
      <svg class="h-5 w-5 opacity-65" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span>{lang === 'ar' ? 'بحث' : 'Search'}</span>
    </button>

    <!-- المحفوظات (مع عدّاد) -->
    <a
      href={`/${lang}/saved`}
      aria-label={t.saved}
      aria-current={pathname.includes('/saved') ? 'page' : undefined}
      class="relative flex flex-1 flex-col items-center justify-center gap-1 px-1 py-2.5 text-[10px] font-bold text-stone-500 transition active:scale-95 dark:text-stone-400"
      style={pathname.includes('/saved') ? 'color:var(--color-teal-600)' : undefined}
    >
      <span class="relative">
        <svg class="h-5 w-5 opacity-65" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <span
          data-saved-badge
          data-saved-lang={lang}
          hidden
          class="absolute -top-1.5 -end-2 grid h-4 min-w-4 place-items-center rounded-full bg-teal-600 px-1 text-[9px] font-black leading-none text-white"
        ></span>
      </span>
      <span>{t.saved}</span>
    </a>

    <!-- الوضع الليلي -->
    <button
      type="button"
      data-theme-toggle
      aria-label={t.themeLabel}
      class="flex flex-1 flex-col items-center justify-center gap-1 px-1 py-2.5 text-[10px] font-bold text-stone-500 transition active:scale-95 dark:text-stone-400"
    >
      <svg class="h-5 w-5 opacity-65 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="hidden h-5 w-5 opacity-65 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
      <span>{lang === 'ar' ? 'الوضع' : 'Theme'}</span>
    </button>
  </div>

  <script>
    import { bindSavedBadge } from '../scripts/saved';
    const lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
    document.querySelectorAll<HTMLElement>('[data-saved-badge]').forEach((el) => {
      bindSavedBadge(el, el.dataset.savedLang || lang);
    });
  </script>
</nav>
