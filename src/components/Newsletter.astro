---
import { ui, type Lang } from '../data/site';
import { ui as dict } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
---
<section
  class="noise relative overflow-hidden rounded-3xl bg-gradient-to-br from-teal-700 via-teal-800 to-cyan-900 px-6 py-12 text-center text-white sm:px-10"
>
  <div class="absolute -top-24 -start-24 h-64 w-64 rounded-full bg-white/5"></div>
  <div class="absolute -bottom-20 -end-16 h-56 w-56 rounded-full bg-amber-400/10"></div>
  <h2 class="font-display relative text-2xl sm:text-3xl">{t.newsletterTitle}</h2>
  <p class="relative mx-auto mt-3 max-w-xl text-sm leading-7 text-teal-100 sm:text-base">
    {t.newsletterText}
  </p>
  <form data-newsletter class="relative mx-auto mt-7 flex max-w-md flex-col gap-2 sm:flex-row">
    <input
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder={t.emailPlaceholder}
      class="min-h-[52px] w-full rounded-full border-0 bg-white/95 px-5 py-3.5 text-base text-stone-800 placeholder:text-stone-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-amber-300/40"
    />
    <button
      type="submit"
      class="min-h-[52px] shrink-0 rounded-full bg-stone-900 px-7 py-3.5 text-base font-bold text-white transition hover:bg-stone-700 active:scale-[0.98] dark:bg-white dark:text-stone-900 dark:hover:bg-amber-300"
    >
      {t.subscribe}
    </button>
  </form>
  <p data-newsletter-msg class="relative mt-4 hidden text-sm font-semibold text-amber-300"></p>
</section>

<script>
  const labels: Record<string, string> = {
    ar: 'شكراً لك! سيتم تفعيل الاشتراك قريباً ✅',
    en: 'Thank you! Subscription will be enabled soon ✅',
  };
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
      const msg = document.querySelector<HTMLParagraphElement>('[data-newsletter-msg]');
      if (msg) {
        msg.textContent = labels[lang];
        msg.classList.remove('hidden');
      }
      form.reset();
    });
  });
</script>
