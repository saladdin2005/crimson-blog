---
import { categories, site, type Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;

const home = `/${lang}/`;
const about = `/${lang}/about`;

// تبديل اللغة (ينتقل إلى نفس الصفحة باللغة الأخرى)
const otherLang: Lang = lang === 'ar' ? 'en' : 'ar';
let switchPath = `/${otherLang}/`;
if (pathname.startsWith(`/${lang}/`) || pathname === `/${lang}`) {
  switchPath = `/${otherLang}` + pathname.slice(lang.length + 1);
}

interface NavLink {
  label: string;
  href: string;
  active: boolean;
  accent?: string;
  icon?: string;
}

const links: NavLink[] = [
  {
    label: t.home,
    href: home,
    active: pathname === home || pathname === `/${lang}`,
    icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  },
  ...Object.entries(categories).map(([slug, cat]) => ({
    label: cat[lang],
    href: `/${lang}/category/${slug}`,
    active: pathname.includes(`/category/${slug}`),
    accent: cat.accent,
    icon: cat.icon,
  })),
  {
    label: t.saved,
    href: `/${lang}/saved`,
    active: pathname.includes('/saved'),
    icon: '<path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>',
  },
  {
    label: t.about,
    href: about,
    active: pathname.includes('/about'),
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  },
];
---

<!-- خلفية معتمة خلف الدرج (هاتف فقط) -->
<div data-sidebar-backdrop class="fixed inset-0 z-[70] hidden bg-stone-900/45 backdrop-blur-sm lg:hidden"></div>

<!-- القائمة الجانبية: درج منزلق على الهاتف، عمود لاصق على الحاسوب -->
<aside
  id="site-sidebar"
  data-sidebar
  class="side-drawer no-scrollbar fixed inset-y-0 start-0 z-[75] w-72 max-w-[82vw] overflow-y-auto border-e border-stone-200/70 bg-white p-5 pt-[calc(1.25rem_+_env(safe-area-inset-top,0px))] pb-[calc(1.25rem_+_env(safe-area-inset-bottom,0px))] shadow-2xl dark:border-white/10 dark:bg-stone-950 lg:sticky lg:top-8 lg:z-auto lg:inset-y-auto lg:self-start lg:w-52 lg:max-w-none lg:overflow-visible lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none dark:lg:bg-transparent"
  aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'}
>
  <!-- الشعار أعلى القائمة (نمط أراجيك) -->
  <a href={home} class="mb-5 flex items-center gap-2.5" aria-label={site.name[lang]}>
    <img
      src="/images/logo-crimson.png"
      alt=""
      width="66"
      height="66"
      class="h-[66px] w-[66px] object-contain drop-shadow-md drop-shadow-teal-700/20 transition hover:drop-shadow-lg"
    />
    <span class="flex flex-col leading-none">
      <span class="font-display text-xl tracking-tight text-stone-900 dark:text-white">{site.name[lang]}</span>
      <span class="mt-1 text-[10px] font-bold uppercase tracking-[0.22em] text-stone-400 dark:text-stone-500">{site.name[otherLang]}</span>
    </span>
  </a>

  <!-- فاصل + زر إخفاء القائمة -->
  <div class="mb-4 flex items-center gap-3">
    <span class="h-px flex-1 bg-stone-200 dark:bg-stone-700"></span>
    <button
      data-sidebar-close
      type="button"
      aria-label={lang === 'ar' ? 'إخفاء قائمة الأقسام' : 'Hide sections menu'}
      title={lang === 'ar' ? 'إخفاء القائمة' : 'Hide menu'}
      class="grid h-11 w-11 shrink-0 place-items-center rounded-full text-stone-400 transition hover:bg-stone-100 hover:text-teal-700 dark:hover:bg-white/10 dark:hover:text-teal-400 lg:hidden"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex flex-col gap-1.5">
    {links.map((link) => (
      <a
        href={link.href}
        class={`flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-[13px] font-bold leading-snug transition ${
          link.active
            ? 'text-teal-700 dark:text-teal-400'
            : 'text-stone-700 hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-white/5 dark:hover:text-teal-400'
        }`}
      >
        <span
          class={`grid h-5 w-5 shrink-0 place-items-center ${!link.active && !link.accent ? 'text-stone-400 dark:text-stone-500' : ''}`}
          style={!link.active && link.accent ? `color:${link.accent}` : undefined}
        >
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon}></svg>
        </span>
        <span class="min-w-0 flex-1">{link.label}</span>
      </a>
    ))}
  </nav>

  <!-- زخرفة ختامية -->
  <p class="mt-6 text-center text-lg text-teal-400/70 dark:text-teal-300/50" aria-hidden="true">❦</p>
  <p class="mt-1 text-center text-xs leading-5 text-stone-400 dark:text-stone-500">
    {site.tagline[lang]}
  </p>

  <!-- أدوات: الوضع الليلي + تبديل اللغة -->
  <div class="mt-4 flex items-center justify-center gap-1">
    <button
      data-theme-toggle
      type="button"
      aria-label={t.themeLabel}
      class="grid h-11 w-11 place-items-center rounded-full text-stone-500 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-400 dark:hover:bg-white/10 dark:hover:text-teal-400 lg:h-9 lg:w-9"
    >
      <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
    </button>
    <a
      href={switchPath}
      class="inline-flex min-h-11 items-center rounded-full px-4 py-2 text-sm font-bold text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-white/10 dark:hover:text-teal-400 lg:min-h-0 lg:px-3 lg:py-1.5"
    >
      {otherLang === 'ar' ? 'عربي' : 'EN'}
    </a>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-sidebar-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-sidebar-close]');
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  let lastTrigger: HTMLElement | null = null;

  // تبديل الوضع الليلي (الزر انتقل إلى القائمة الجانبية)
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // العناصر القابلة للتركيز داخل الدرج (لحبس التركيز أثناء فتحه)
  const focusables = () =>
    sidebar
      ? Array.from(sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
          (el) => el.offsetParent !== null,
        )
      : [];

  // على الحاسوب القائمة ثابتة ودائمة الظهور؛ هذا الدرج للهاتف فقط
  const setOpen = (open: boolean) => {
    if (!sidebar || !backdrop) return;
    const wasOpen = sidebar.classList.contains('is-open');
    sidebar.classList.toggle('is-open', open);
    backdrop.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
    toggles.forEach((btn) => btn.setAttribute('aria-expanded', String(open)));

    if (open) {
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
      if (!wasOpen) {
        lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        requestAnimationFrame(() => closeBtn?.focus());
      }
    } else {
      sidebar.removeAttribute('role');
      sidebar.removeAttribute('aria-modal');
      if (wasOpen && lastTrigger && !desktopQuery.matches) lastTrigger.focus();
    }
  };

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => setOpen(!sidebar?.classList.contains('is-open')));
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (!sidebar?.classList.contains('is-open')) return;
    if (e.key === 'Escape') {
      setOpen(false);
      return;
    }
    if (e.key !== 'Tab') return;
    const items = focusables();
    if (items.length === 0) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
  // إغلاق الدرج عند توسعة الشاشة إلى الحاسوب
  desktopQuery.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
