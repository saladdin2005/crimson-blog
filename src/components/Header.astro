---
import { site, type Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === 'ar' ? 'en' : 'ar';
const pathname = Astro.url.pathname;

let switchPath = `/${otherLang}/`;
if (pathname.startsWith(`/${lang}/`) || pathname === `/${lang}`) {
  switchPath = `/${otherLang}` + pathname.slice(lang.length + 1);
}
const home = `/${lang}/`;
const otherLangLabel = otherLang === 'ar' ? 'عربي' : 'EN';
---
<header class="sticky top-0 z-50 border-b border-stone-200/70 bg-white/70 pt-[env(safe-area-inset-top,0px)] backdrop-blur-2xl backdrop-saturate-150 dark:border-white/10 dark:bg-stone-950/60 lg:hidden">
  <div class="mx-auto flex direction-ltr max-w-[1160px] items-center justify-between gap-2.5 px-4 py-2.5 sm:px-6">
    <!-- الشعار (دائمًا على اليسار) -->
    <a href={home} class="shrink-0" aria-label={site.name[lang]}>
      <img
        src="/images/logo-crimson.png"
        alt=""
        width="48"
        height="48"
        class="h-[48px] w-[48px] object-contain drop-shadow-md drop-shadow-teal-700/20 transition hover:drop-shadow-lg"
      />
    </a>

    <!-- الأيقونات + القائمة (دائمًا على اليمين) -->
    <div class="flex items-center gap-2">
      <!-- تبديل اللغة -->
      <a
        href={switchPath}
        aria-label={lang === 'ar' ? 'الإنجليزية' : 'Arabic'}
        class="grid h-10 w-10 place-items-center rounded-full text-sm font-bold text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        {otherLangLabel}
      </a>

      <!-- بحث (يفتح الواجهة الكاملة) -->
      <button
        data-search-open
        aria-label={t.searchPlaceholder}
        class="grid h-10 w-10 place-items-center rounded-full text-stone-500 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>

      <!-- الوضع الليلي -->
      <button
        data-theme-toggle
        aria-label={t.themeLabel}
        class="grid h-10 w-10 place-items-center rounded-full text-stone-500 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
      </button>

      <!-- القائمة (☰) -->
      <button
        data-sidebar-toggle
        aria-label={t.menuLabel}
        aria-expanded="false"
        class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // تبديل الوضع الليلي — ربط واحد فقط على الصفحة
  // (يمنع تكرار المستمع بين المكوّنات: تبديلان في نقرة واحدة = لا تغيير)
  if (!(window as any).__themeToggleBound) {
    (window as any).__themeToggleBound = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest?.('[data-theme-toggle]');
      if (!btn) return;
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>