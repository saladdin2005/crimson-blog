---
import { site, type Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === 'ar' ? 'en' : 'ar';
const pathname = Astro.url.pathname;

let switchPath = `/${otherLang}/`;
if (pathname.startsWith(`/${lang}/`) || pathname === `/${lang}`) {
  switchPath = `/${otherLang}` + pathname.slice(lang.length + 1);
}
const home = `/${lang}/`;
const otherLangLabel = otherLang === 'ar' ? 'عربي' : 'EN';
---
<header class="sticky top-0 z-50 border-b border-stone-200/70 bg-white/70 backdrop-blur-2xl backdrop-saturate-150 dark:border-white/10 dark:bg-stone-950/60">
  <!-- الصف العلوي: قائمة ☰ + شعار + بحث + إجراءات -->
  <div class="mx-auto flex max-w-[1160px] items-center gap-2.5 px-5 py-3 sm:gap-4 sm:px-10 lg:px-16">
    <!-- زر القائمة الجانبية (هاتف فقط) -->
    <button
      data-sidebar-toggle
      aria-label={t.menuLabel}
      aria-expanded="false"
      class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-teal-400 lg:hidden"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <!-- الشعار -->
    <a href={home} class="group flex shrink-0 items-center gap-2" aria-label={site.name[lang]}>
      <img
        src="/images/logo-crimson.png"
        alt=""
        width="44"
        height="44"
        class="h-11 w-11 object-contain drop-shadow-md drop-shadow-teal-700/20 transition group-hover:drop-shadow-lg"
      />
      <span class="font-display hidden items-baseline gap-1.5 text-xl tracking-tight text-stone-900 dark:text-white sm:flex">
        {site.name[lang]}
        <span class="text-base font-medium text-stone-400 dark:text-stone-500">{site.name[otherLang]}</span>
      </span>
    </a>

    <!-- شريط البحث (بنمط Pinterest) -->
    <div class="pin-search flex flex-1 items-center gap-2 rounded-full px-4 py-2.5 transition">
      <svg class="h-4 w-4 shrink-0 text-stone-500 dark:text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        type="text"
        data-search
        placeholder={t.searchPlaceholder}
        class="w-full bg-transparent text-sm font-medium text-stone-700 outline-none placeholder:text-stone-400 dark:text-stone-200 dark:placeholder:text-stone-500"
      />
    </div>

    <!-- الإجراءات -->
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <!-- زر الوضع الليلي -->
      <button
        data-theme-toggle
        aria-label={t.themeLabel}
        class="grid h-10 w-10 place-items-center rounded-full text-stone-500 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
      </button>
      <!-- تبديل اللغة -->
      <a
        href={switchPath}
        class="grid h-10 min-w-10 place-items-center rounded-full px-3 text-sm font-bold text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-teal-400"
      >
        {otherLangLabel}
      </a>
      <!-- الحساب (رمز تجميلي — مخفي على الهاتف لتوفير المساحة) -->
      <span class="hidden h-10 w-10 place-items-center rounded-full bg-stone-200 text-stone-600 dark:bg-stone-800 dark:text-stone-300 sm:grid">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </span>
    </div>
  </div>
</header>

<script>
  // تبديل الوضع الليلي
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // بحث فوري داخل الشبكة (تصفية البطاقات)
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  if (input) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      const cards = document.querySelectorAll<HTMLElement>('[data-card]');
      cards.forEach((card) => {
        const hay = (card.dataset.card || '').toLowerCase();
        card.style.display = !q || hay.includes(q) ? '' : 'none';
      });
    });
  }
</script>
