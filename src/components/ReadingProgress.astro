---
// شريط تقدّم القراءة — يظهر أعلى الصفحة أثناء تصفح المقال
---
<div class="fixed inset-x-0 top-0 z-[60] h-0.5 bg-transparent">
  <div data-progress class="progress-bar h-full w-0 bg-gradient-to-r from-teal-500 to-cyan-400"></div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  const update = () => {
    if (!bar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    bar.style.width = `${progress * 100}%`;
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
