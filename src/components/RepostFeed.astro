---
import { ui } from '../i18n/ui';

interface Props {
  lang: 'ar' | 'en';
  variant?: 'rail' | 'inline';
}

const { lang, variant = 'rail' } = Astro.props;
const t = ui[lang];
const shellClass =
  variant === 'rail'
    ? 'xl:sticky xl:top-8 xl:w-64'
    : 'xl:hidden';
---

<aside data-repost-feed data-lang={lang} data-repost-i18n={JSON.stringify(t)} class={`${shellClass} w-full`} aria-label={t.repostRailTitle}>
  <div class="flex items-center justify-between gap-2 border-b border-stone-200/70 pb-3 dark:border-white/10">
    <h2 class="font-display flex items-center gap-2 text-base text-stone-900 dark:text-white">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-[#a61830]/10 text-[#a61830] dark:bg-[#a61830]/20">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m17 2 4 4-4 4" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><path d="m7 22-4-4 4-4" /><path d="M21 13v2a4 4 0 0 1-4 4H3" />
        </svg>
      </span>
      {t.repostRailTitle}
    </h2>
    <span data-repost-count class="hidden rounded-full bg-stone-200/70 px-2 py-0.5 text-[10px] font-bold text-stone-500 dark:bg-white/10 dark:text-stone-400"></span>
  </div>
  <p class="mt-2 text-[11px] leading-relaxed text-stone-400 dark:text-stone-500">{t.repostRailSubtitle}</p>

  <div data-repost-empty class="mt-3 rounded-2xl border border-dashed border-stone-300 bg-white/50 px-4 py-6 text-center dark:border-white/15 dark:bg-white/5" style="display:none">
    <p class="text-2xl" aria-hidden="true">💬</p>
    <p class="mt-2 text-xs font-bold text-stone-700 dark:text-stone-200">{t.repostEmpty}</p>
    <p class="mt-1 text-[11px] leading-relaxed text-stone-400 dark:text-stone-500">{t.repostEmptyHint}</p>
  </div>

  <div data-repost-list class="no-scrollbar mt-3 space-y-3 xl:max-h-[calc(100vh-11rem)] xl:overflow-y-auto"></div>
</aside>

<script>
  import { getReposts, removeRepost, type Repost } from '../scripts/reposts';

  const feeds = document.querySelectorAll<HTMLElement>('[data-repost-feed]');
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  const avatarColors = ['#a61830', '#8a4520', '#c4475e', '#b06a2c', '#dd8b99', '#9a5a24'];
  const colorFor = (name: string) => {
    let h = 0;
    for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
    return avatarColors[h % avatarColors.length];
  };

  feeds.forEach((feed) => {
    const lang = feed.dataset.lang === 'en' ? 'en' : 'ar';
    const t = JSON.parse(feed.dataset.repostI18n ?? '{}');
    const listEl = feed.querySelector<HTMLElement>('[data-repost-list]');
    const emptyEl = feed.querySelector<HTMLElement>('[data-repost-empty]');
    const countEl = feed.querySelector<HTMLElement>('[data-repost-count]');
    if (!listEl || !emptyEl) return;

    const rel = (iso: string) => {
      const diff = Math.max(0, Date.now() - new Date(iso).getTime());
      const m = Math.floor(diff / 60000);
      if (m < 1) return t.repostNow;
      if (m < 60) return `${m} ${t.repostMin}`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h} ${t.repostHour}`;
      const d = Math.floor(h / 24);
      return `${d} ${t.repostDay}`;
    };

    const render = () => {
      const items = getReposts(lang);
      if (countEl) {
        countEl.textContent = String(items.length);
        countEl.classList.toggle('hidden', items.length === 0);
      }
      emptyEl.style.display = items.length ? 'none' : 'block';
      listEl.innerHTML = items
        .map((r: Repost) => {
          const author = r.author || (lang === 'ar' ? 'قارئ' : 'Reader');
          const initial = Array.from(author)[0] ?? '?';
          const commentHtml = r.comment
            ? `<p class="mt-2 line-clamp-3 text-[13px] font-semibold leading-relaxed text-stone-800 dark:text-stone-100" dir="auto">${esc(r.comment)}</p>`
            : '';
          return `
          <article class="rounded-2xl border border-stone-200/80 bg-white/90 p-3.5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-stone-900/70">
            <div class="flex items-center gap-2">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-[11px] font-black text-white" style="background:${esc(colorFor(author))}">${esc(initial)}</span>
              <span class="min-w-0 flex-1 truncate text-xs font-bold text-stone-800 dark:text-stone-100">${esc(author)}</span>
              <time class="shrink-0 text-[10px] text-stone-400 dark:text-stone-500">${esc(rel(r.createdAt))}</time>
              <button type="button" data-repost-delete="${esc(r.id)}" aria-label="${esc(t.repostRemove)}" title="${esc(t.repostRemove)}"
                class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-stone-300 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-500/10">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
              </button>
            </div>
            <blockquote class="mt-2.5 line-clamp-3 border-s-2 border-[#a61830] ps-2.5 text-[12.5px] leading-relaxed text-stone-600 dark:text-stone-300" dir="auto">${esc(r.quote)}</blockquote>
            ${commentHtml}
            <a href="${esc(r.url)}" class="mt-2.5 flex items-center gap-1 text-[11px] font-bold text-[#a61830] transition hover:text-[#7a0f22] dark:text-[#dd8b99]">
              <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" /><path d="M8 7h8M8 11h8M8 15h5" /></svg>
              <span class="truncate">${esc(r.title)}</span>
            </a>
          </article>`;
        })
        .join('');

      listEl.querySelectorAll<HTMLButtonElement>('[data-repost-delete]').forEach((btn) => {
        btn.addEventListener('click', () => removeRepost(btn.dataset.repostDelete ?? ''));
      });
    };

    render();
    window.addEventListener('reposts-changed', render);
    window.addEventListener('storage', (e) => { if (e.key === 'crimson-reposts-v1') render(); });
  });
</script>
