---
import type { CollectionEntry } from 'astro:content';
import { categories, authors, coverUrl, type Lang } from '../data/site';
import { formatDate } from '../i18n/ui';
import Cover from './Cover.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  lang: Lang;
  /** ارتفاع الصورة — يُستخدم لتنويع أطوال شبكة Masonry */
  ratio?: string;
}

const { article, lang, ratio = 'aspect-[4/5]' } = Astro.props;
const cat = categories[article.data.category];
const author = authors[article.data.author];
const slug = article.id.split('/').pop();
const href = `/${lang}/articles/${slug}`;
const searchable = `${article.data.title} ${article.data.description} ${cat[lang]}`;

// بيانات الحفظ تُمرَّر إلى الزر وتُخزَّن في المتصفح
const savePayload = JSON.stringify({
  lang,
  slug,
  title: article.data.title,
  url: href,
  image: article.data.image ?? coverUrl(slug, 400, 300),
  catLabel: cat[lang],
  accent: cat.accent,
  date: article.data.date.toISOString().slice(0, 10),
});
---
<article data-card={searchable} class="group break-inside-avoid">
  <div class="relative overflow-hidden rounded-2xl bg-stone-100 dark:bg-stone-800">
    <a href={href} aria-label={article.data.title}>
      <Cover article={article} lang={lang} class={`${ratio} max-sm:aspect-[4/3]`} />
    </a>

    <!-- شارة التصنيف -->
    <span class="absolute end-3 top-3 rounded-full bg-white/90 px-3 py-1 text-[11px] font-bold text-stone-700 backdrop-blur-md dark:bg-black/60 dark:text-stone-200">
      {cat[lang]}
    </span>

    <!-- زر الحفظ 🔖 — يظهر دائماً ويعمل باللمس على الهاتف -->
    <button
      type="button"
      class="save-btn absolute start-3 top-3 h-11 w-11 sm:h-9 sm:w-9"
      data-save-card
      data-payload={savePayload}
      aria-pressed="false"
      aria-label={lang === 'ar' ? 'حفظ' : 'Save'}
      title={lang === 'ar' ? 'حفظ للقراءة لاحقاً' : 'Save for later'}
    >
      <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </button>

    <!-- تراكب العنوان عند المرور (للأجهزة ذات المؤشر الدقيق فقط) -->
    <div class="pin-hover-overlay pointer-events-none absolute inset-0 flex-col justify-end bg-gradient-to-b from-transparent to-black/60 p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      <a href={href} class="line-clamp-2 text-sm font-bold leading-snug text-white drop-shadow-lg">
        {article.data.title}
      </a>
    </div>
  </div>

  <!-- معلومات أسفل الصورة -->
  <div class="px-1 pt-3">
    <a href={href} class="line-clamp-2 min-h-6 text-base font-bold leading-snug text-stone-800 transition hover:text-teal-700 dark:text-stone-100 dark:hover:text-teal-400 md:text-sm">
      {article.data.title}
    </a>
    <div class="mt-2 flex items-center gap-2 text-xs text-stone-400 dark:text-stone-500">
      <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gradient-to-br from-teal-500 to-cyan-600 text-[10px] font-black text-white">
        {author.name[lang].charAt(0)}
      </span>
      <span class="truncate font-medium text-stone-600 dark:text-stone-300">{author.name[lang]}</span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">{formatDate(article.data.date, lang)}</span>
    </div>
  </div>
</article>

<script>
  import { bindSaveButton, type SavedArticle } from '../scripts/saved';

  const lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
  const labels = {
    ar: { save: 'حفظ للقراءة لاحقاً', isSaved: 'محفوظ — اضغط للإزالة', remove: 'إزالة من المحفوظات' },
    en: { save: 'Save for later', isSaved: 'Saved — tap to remove', remove: 'Remove from saved' },
  }[lang];

  document.querySelectorAll<HTMLButtonElement>('[data-save-card]').forEach((btn) => {
    const payload = JSON.parse(btn.dataset.payload || '{}') as SavedArticle;
    if (payload?.slug) bindSaveButton(btn, payload, labels);
  });
</script>
