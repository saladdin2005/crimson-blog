---
import type { CollectionEntry } from 'astro:content';
import { categories, type Lang } from '../data/site';
import { ui } from '../i18n/ui';
import Cover from './Cover.astro';

interface Props {
  articles: CollectionEntry<'articles'>[];
  lang: Lang;
}

const { articles, lang } = Astro.props;
const t = ui[lang];
---
{articles.length > 0 && (
  <section class="reveal mb-10 grid gap-4 sm:grid-cols-2">
    {articles.map((article) => {
      const cat = categories[article.data.category];
      const slug = article.id.split('/').pop();
      const href = `/${lang}/articles/${slug}`;
      return (
        <a
          href={href}
          class="group relative block overflow-hidden rounded-3xl shadow-lg shadow-stone-900/10 dark:shadow-black/30"
        >
          <!-- صورة المقال (تدرج لوني مريح) — نسبة موحّدة للاثنتين لضمان التساو التام -->
          <Cover article={article} lang={lang} class="aspect-[16/10] w-full" />
          <!-- تراكب متدرّج لوضوح النص -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>

          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <span class="mb-2 w-fit rounded-full bg-white/90 px-3 py-1 text-[11px] font-bold text-stone-800 backdrop-blur-md dark:bg-black/60 dark:text-stone-200">
              {cat[lang]}
            </span>
            <h3 class="font-display line-clamp-2 text-lg leading-snug text-white drop-shadow-lg sm:text-xl">
              {article.data.title}
            </h3>
            <span class="mt-3 inline-flex w-fit items-center gap-1.5 text-xs font-bold text-teal-300 transition group-hover:text-teal-200">
              {t.readMore}
              <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span>
            </span>
          </div>
        </a>
      );
    })}
  </section>
)}
